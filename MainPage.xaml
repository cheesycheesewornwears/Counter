<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="Counter.MainPage"
             xmlns:vm="clr-namespace:Counter.ViewModels"
             x:DataType="vm:MainPageViewModel">
    <ScrollView>
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition/>
                <RowDefinition/>
            </Grid.RowDefinitions>

            <VerticalStackLayout
                Grid.Row="0"
                Padding="30,0"
                Spacing="25">

                <Label
                    Text="Add counter"
                    FontSize="Caption" />

                <Entry
                    Text="{Binding NewCounterName}"
                    Placeholder="Enter counter name" />

                <Button
                    Text="Add"
                    Command="{Binding AddCounterCommand}" />
            </VerticalStackLayout>
            
            <CollectionView
                Grid.Row="1"
                ItemsSource="{Binding Counters}">
                
                <CollectionView.ItemTemplate>
                    <DataTemplate
                        x:DataType="vm:CounterViewModel">
                        
                        <Border
                            Padding="15"
                            Stroke="Black">

                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition/>
                                    <ColumnDefinition/>
                                    <ColumnDefinition/>
                                    <ColumnDefinition/>
                                </Grid.ColumnDefinitions>

                                <Label
                                    Grid.Column="0"
                                    Text="{Binding Name}" />

                                <Label
                                    Grid.Column="1"
                                    Text="{Binding Count}" />

                                <Button 
                                    Grid.Column="2"
                                    Text="+"
                                    Command="{Binding IncrementCountCommand}" />
                                
                                <Button 
                                    Grid.Column="3"
                                    Text="-"
                                    Command="{Binding DecrementCountCommand}" />
                            </Grid>
                        </Border>
                    </DataTemplate>
                </CollectionView.ItemTemplate>
            </CollectionView>
        </Grid>
    </ScrollView>
</ContentPage>